# Copy to .env (never commit .env). Used by docker-compose.yml.
# Generate secrets with URL-safe characters only (they are embedded in DATABASE_URL):
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

POSTGRES_DB=qbadminton
POSTGRES_USER=qbadminton
POSTGRES_PASSWORD=change-me

# Shared secret for the Chrome extension (paste it into the extension popup).
INGEST_API_KEY=change-me-to-a-long-random-string

# Required for AI parsing. Without it, posts are stored and stay "pending".
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Delete sessions and raw posts older than N days, checked every N hours.
CLEANUP_ENABLED=true
CLEANUP_RETENTION_DAYS=2
CLEANUP_INTERVAL_HOURS=48

# Loopback port that the Cloudflare Tunnel public hostname points to.
WEB_PORT=8082
LOG_LEVEL=info
