# Local development (npm run dev). In Docker, values come from the root .env.
DATABASE_URL=postgres://qbadminton:qbadminton@127.0.0.1:5434/qbadminton
PORT=3000
LOG_LEVEL=info
RUN_MIGRATIONS=true

# Shared secret entered in the Chrome extension popup (min 24 chars).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INGEST_API_KEY=change-me-to-a-long-random-string

# Without a key the worker stays idle and ingested posts remain "pending".
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=5000
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_MS=30000
JOB_BACKOFF_MAX_MS=1800000
JOB_STALE_AFTER_MS=600000

CLEANUP_ENABLED=true
CLEANUP_RETENTION_DAYS=2
CLEANUP_INTERVAL_HOURS=48
